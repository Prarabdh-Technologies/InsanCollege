      "name": "Primary action",
      "kind": "button",
      "html": "<button class=\"ds-button\" type=\"button\">Prepare enquiry</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:18px;min-height:48px;padding:13px 20px;background:var(--action,#a84722);color:#fff;border:1px solid var(--action,#a84722);font:.9rem/1.65 var(--sans,Arial,sans-serif);cursor:pointer;transition:background-color .2s,box-shadow .2s}.ds-button:hover{background:#80351a;border-color:#80351a}.ds-button:focus-visible{outline:3px solid var(--focus,#a84722);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}",

      "css": ".ds-field{color:var(--ink,#173954);font-family:var(--sans,Arial,sans-serif)}.ds-field label{display:block;margin-bottom:7px;font-size:.88rem;font-weight:600}.ds-field label span{font-size:.75rem;font-weight:400;color:var(--muted,#52616c)}.ds-field input{width:100%;min-width:0;min-height:46px;border:1px solid var(--input-line,#768a98);border-radius:3px;padding:10px 12px;background:var(--surface,#fff);color:var(--ink,#173954);font-size:1rem;caret-color:var(--accent,#a84722)}.ds-field input:focus-visible{outline:3px solid var(--focus,#a84722);outline-offset:4px}.ds-field input:user-invalid{border-color:var(--error,#af2828)}",

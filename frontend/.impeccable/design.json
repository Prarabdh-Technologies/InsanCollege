      "css": ".ds-nav{display:flex;justify-content:space-between;background:var(--navy,#173954);color:#fff;font:.83rem/1.65 var(--sans,Arial,sans-serif)}.ds-nav a{display:flex;align-items:center;padding:11px 12px;min-height:44px;color:inherit;text-decoration:none}.ds-nav a:hover{background:#294e6a;color:#fff}.ds-nav a:focus-visible{outline:3px solid #efb079;outline-offset:-4px}",
